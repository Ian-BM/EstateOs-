[Unit]
Description=Estate OS Django application
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=estateos
Group=estateos
WorkingDirectory=/srv/estate-os/current
EnvironmentFile=/etc/estate-os/production.env
ExecStart=/srv/estate-os/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8010 --workers 2 --threads 2 --timeout 60 --access-logfile - --error-logfile - --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/estate-os/shared

[Install]
WantedBy=multi-user.target
